{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "packages/*/dist/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "examples/scoped/generated/**"
  ],
  "overrides": [
    {
      "files": ["*.md", "**/*.md", "*.mdx", "**/*.mdx"],
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}
