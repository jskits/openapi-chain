{
  "openapi": "3.1.0",
  "info": {
    "title": "Scoped catalog example",
    "version": "1.0.0",
    "description": "BUILD_ONLY_OPENAPI_DOCUMENT"
  },
  "paths": {
    "/items": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    },
    "/admin": {
      "get": {
        "responses": {
          "204": {
            "description": "UNSELECTED_OPERATION"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "filter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
