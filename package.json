{
  "name": "openapi-chain",
  "version": "0.3.0",
  "description": "A tiny OpenAPI-typed fluent client with zero client codegen and opt-in exact-wire serialization.",
  "keywords": [
    "client",
    "openapi",
    "typescript"
  ],
  "homepage": "https://github.com/jskits/openapi-chain#readme",
  "bugs": {
    "url": "https://github.com/jskits/openapi-chain/issues"
  },
  "license": "MIT",
  "author": "unadlib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jskits/openapi-chain.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./strict": {
      "import": {
        "types": "./dist/strict.d.ts",
        "default": "./dist/strict.js"
      },
      "require": {
        "types": "./dist/strict.d.cts",
        "default": "./dist/strict.cjs"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      },
      "require": {
        "types": "./dist/metadata.d.cts",
        "default": "./dist/metadata.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'coverage']) rmSync(path, { recursive: true, force: true });\"",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm test:generated && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:package && pnpm size:check && pnpm benchmark:types",
    "commit": "cz",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only && pnpm format",
    "release": "pnpm check && changeset publish",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "prepare": "husky",
    "verify:package": "pnpm test:package",
    "size:check": "node scripts/check-size.mjs",
    "generate:example": "openapi-typescript examples/example.yaml -o examples/schema.d.ts && openapi-typescript examples/service.openapi.json -o examples/service-schema.d.ts && openapi-typescript test/fixtures/conformance.openapi.json -o test/fixtures/conformance-schema.d.ts",
    "test:generated": "node scripts/check-generated.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "benchmark:types": "node scripts/benchmark-types.mjs && node scripts/benchmark-types-project.mjs",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "benchmark:size": "node scripts/benchmark-size.mjs",
    "benchmark": "pnpm build && pnpm benchmark:types && pnpm benchmark:runtime && pnpm benchmark:size && pnpm benchmark:metadata",
    "benchmark:metadata": "node scripts/benchmark-metadata.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "commitizen": "4.3.2",
    "cross-spawn": "7.0.6",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "1.63.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
