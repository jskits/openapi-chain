  },
  "paths": {
    "/Plugins/{pluginId}/{version}": {
      "delete": {
        "parameters": [
          { "name": "pluginId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "version", "in": "path", "required": true, "schema": { "type": "object" } }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  }
}
