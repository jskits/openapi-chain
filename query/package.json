{
  "name": "openapi-chain-query",
  "version": "0.1.0",
  "description": "Explicit operation query keys and fetchers for TanStack Query and SWR.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jskits/openapi-chain.git",
    "directory": "query"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  }
}
